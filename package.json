{
  "name": "markdock",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "generate-icons": "node scripts/generate-icons.mjs",
    "zip": "npm run build && mkdir -p release && rm -f release/markdock-v1.1.0.zip && (cd dist && zip -r ../release/markdock-v1.1.0.zip .)"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "pinyin-match": "^1.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
