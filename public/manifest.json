{
  "manifest_version": 3,
  "name": "MarkDock",
  "version": "1.1.0",
  "description": "原生书签侧边栏（快捷键秒搜、自由拖拽排序、深色模式）+ 精准失效书签清理、去重与本地回收站二合一工具",
  "permissions": ["bookmarks", "storage", "sidePanel", "tabs", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "打开 MarkDock 侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "打开 / 切换书签侧边栏"
    },
    "focus-search": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "打开侧边栏并聚焦书签搜索框"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
