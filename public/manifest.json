{
  "manifest_version": 3,
  "name": "MarkDock",
  "version": "1.2.0",
  "description": "原生书签侧边栏（快捷键秒搜、自由拖拽排序、深色模式）+ 精准失效书签清理、去重与本地回收站二合一工具",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "tabs",
    "favicon",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "打开 MarkDock 侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "focus-search": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "打开纯净书签搜索（隐藏 AI 侧栏）"
    },
    "open-ai": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "打开并展开 AI 侧栏"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
